# Used by docker-compose.yml. Copy to .env and fill in.

# Database password. Set it BEFORE the first `docker compose up`: Postgres only applies it when the
# volume is created.
POSTGRES_PASSWORD=change-me

# Generate with: npx auth secret   (or any long random string)
AUTH_SECRET=

# Public URL sellers use (your domain when using the Cloudflare tunnel). Google redirects here:
# add <AUTH_URL>/api/auth/callback/google to the OAuth client in Google Cloud Console.
AUTH_URL=http://localhost:3100
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated e-mails that become admin on sign-in
ADMIN_EMAILS=omarsaifeddingorrab@gmail.com

# Port published on this machine (phones use http://<machine-ip>:<port>)
WEB_PORT=3100

# Only for `docker compose --profile tunnel up` (Cloudflare Zero Trust → Tunnels → token)
TUNNEL_TOKEN=
