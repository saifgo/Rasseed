# PostgreSQL (docker compose at repo root exposes it on 5433)
DATABASE_URL=postgres://rasseed:rasseed@localhost:5433/rasseed

# Auth.js — generate with: npx auth secret
AUTH_SECRET=change-me
# Public URL sellers use to reach the site (needed for Google OAuth callback)
AUTH_URL=http://localhost:3100
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma separated e-mails that get the admin role on sign-in
ADMIN_EMAILS=omarsaifeddingorrab@gmail.com

# Enables a password-less "dev login" form. NEVER enable in production.
AUTH_DEV_LOGIN=false

# Where payment proof uploads are stored
STORAGE_DIR=./storage
